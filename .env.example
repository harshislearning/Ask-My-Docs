# Copy to .env and fill in. .env is gitignored.

# Required from Phase 4 onward (generation). Not needed for ingestion.
GROQ_API_KEY=

# Optional: override any config value without editing config/default.yaml.
# Pattern: ASKMYDOCS_<SECTION>__<FIELD>  (double underscore separates nesting)
# ASKMYDOCS_CHUNKING__CHUNK_TOKENS=512
# ASKMYDOCS_LOGGING__FORMAT=json
# ASKMYDOCS_LOGGING__LEVEL=DEBUG

# Optional: point at a different config file entirely (CI uses config/test.yaml)
# ASKMYDOCS_CONFIG_FILE=config/test.yaml

# Optional: keep HuggingFace model downloads inside the repo instead of ~/.cache
# HF_HOME=.hf_cache
